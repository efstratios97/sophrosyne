                    <execution>
                        <configuration>
                            <apiPackage>sophrosyne_api.core.internalactionrecommendationservice.api</apiPackage>
                            <configOptions>
                                <interfaceOnly>true</interfaceOnly>
                                <useJakartaEe>true</useJakartaEe>
                            </configOptions>
                            <generatorName>spring</generatorName>
                            <inputSpec>${project.basedir}/apis/internal_action_recommendation_service_api.yml
                            </inputSpec>
