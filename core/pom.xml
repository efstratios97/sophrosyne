                            <inputSpec>${project.basedir}/apis/external_action_archive_service_api.yml</inputSpec>
                            <modelPackage>sophrosyne_api.core.actionarchiveservice.model</modelPackage>
                        </configuration>
                        <goals>
                            <goal>generate</goal>
                        </goals>
