                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <id>create-control-panel-service-api</id>
                    </execution>

                    <execution>
                        <configuration>
                            <apiPackage>sophrosyne_api.core.controlpaneldashboardservice.api</apiPackage>
                            <configOptions>
                                <interfaceOnly>true</interfaceOnly>
                                <useJakartaEe>true</useJakartaEe>
                            </configOptions>
                            <generatorName>spring</generatorName>
                            <inputSpec>${project.basedir}/apis/control_panel_dashboard_service_api.yml</inputSpec>
                            <modelPackage>sophrosyne_api.core.controlpaneldashboardservice.model</modelPackage>
                        </configuration>
                        <goals>
