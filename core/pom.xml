        <!-- Metrics dependencies -->
        <dependency>
            <artifactId>micrometer-core</artifactId>
            <groupId>io.micrometer</groupId>
        </dependency>

        <dependency>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <groupId>io.micrometer</groupId>
        </dependency>

        <dependency>
            <artifactId>opentelemetry-api</artifactId>
            <groupId>io.opentelemetry</groupId>
            <version>1.51.0</version>
        </dependency>

        <dependency>
            <artifactId>opentelemetry-sdk</artifactId>
            <groupId>io.opentelemetry</groupId>
            <version>1.51.0</version>
        </dependency>

        <dependency>
            <artifactId>opentelemetry-exporter-prometheus</artifactId>
            <groupId>io.opentelemetry</groupId>
            <version>1.51.0-alpha</version>
        </dependency>
        <!-- End of Metrics dependencies -->

        <!-- Boilerplate Dependencies -->
        <dependency>
            <artifactId>lombok</artifactId>
            <groupId>org.projectlombok</groupId>
            <version>1.18.42</version>
        </dependency>

        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>1.6.3</version>
        </dependency>
        <!-- Boilerplate Dependencies -->

        <!-- Test dependencies -->
        <dependency>
            <artifactId>spring-boot-starter-test</artifactId>
            <groupId>org.springframework.boot</groupId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <artifactId>spring-boot-testcontainers</artifactId>
            <groupId>org.springframework.boot</groupId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>1.21.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>1.21.4</version>
            <scope>test</scope>
        </dependency>

    </dependencies>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>2.0.5</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <groupId>org.springframework.boot</groupId>
            </plugin>

            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <artifactId>lombok</artifactId>
                            <groupId>org.projectlombok</groupId>
                            <version>1.18.42</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>1.6.3</version>
                        </path>
                    </annotationProcessorPaths>
                    <release>25</release>
                </configuration>
                <groupId>org.apache.maven.plugins</groupId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <configuration>
                            <apiPackage>sophrosyne_api.core.userservice.api</apiPackage>
                            <configOptions>
                                <interfaceOnly>true</interfaceOnly>
                                <useJakartaEe>true</useJakartaEe>
                            </configOptions>
                            <generatorName>spring</generatorName>
                            <inputSpec>${project.basedir}/apis/user_service_api.yml</inputSpec>
                            <modelPackage>sophrosyne_api.core.userservice.model</modelPackage>
                        </configuration>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <id>create-user-api</id>
                    </execution>

                    <execution>
                        <configuration>
                            <apiPackage>sophrosyne_api.core.apikeyservice.api</apiPackage>
                            <configOptions>
                                <interfaceOnly>true</interfaceOnly>
                                <useJakartaEe>true</useJakartaEe>
                            </configOptions>
                            <generatorName>spring</generatorName>
                            <inputSpec>${project.basedir}/apis/apikey_service_api.yml</inputSpec>
                            <modelPackage>sophrosyne_api.core.apikeyservice.model</modelPackage>
                        </configuration>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <id>create-apikey-api</id>
                    </execution>

                    <execution>
                        <configuration>
                            <apiPackage>sophrosyne_api.core.actionservice.api</apiPackage>
                            <configOptions>
                                <interfaceOnly>true</interfaceOnly>
                                <useJakartaEe>true</useJakartaEe>
                            </configOptions>
                            <generatorName>spring</generatorName>
                            <inputSpec>${project.basedir}/apis/action_service_api.yml</inputSpec>
                            <modelPackage>sophrosyne_api.core.actionservice.model</modelPackage>
                        </configuration>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <id>create-action-api</id>
                    </execution>

                    <execution>
                        <configuration>
                            <apiPackage>sophrosyne_api.core.dynamicactionservice.api</apiPackage>
                            <configOptions>
                                <interfaceOnly>true</interfaceOnly>
                                <useJakartaEe>true</useJakartaEe>
                                <schemaMappings>
                                    DropdownOption=sophrosyne_api.core.internaldropdownoptionservice.model.DropdownOption
                                </schemaMappings>
                            </configOptions>
                            <generatorName>spring</generatorName>
                            <inputSpec>${project.basedir}/apis/dynamic_action_service_api.yml</inputSpec>
                            <modelPackage>sophrosyne_api.core.dynamicactionservice.model</modelPackage>
                        </configuration>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <id>create-dynamic-action-api</id>
                    </execution>

                    <execution>
                        <configuration>
                            <apiPackage>sophrosyne_api.core.actionarchiveservice.api</apiPackage>
                            <configOptions>
                                <interfaceOnly>true</interfaceOnly>
                                <useJakartaEe>true</useJakartaEe>
                            </configOptions>
                            <generatorName>spring</generatorName>
                            <inputSpec>${project.basedir}/apis/action_archive_service_api.yml</inputSpec>
                            <modelPackage>sophrosyne_api.core.actionarchiveservice.model</modelPackage>
