                    <execution>
                        <configuration>
                            <apiPackage>sophrosyne_api.core.externalactionconfirmation.api</apiPackage>
                            <configOptions>
                                <interfaceOnly>true</interfaceOnly>
                                <useJakartaEe>true</useJakartaEe>
                            </configOptions>
                            <generatorName>spring</generatorName>
                            <inputSpec>${project.basedir}/apis/external_action_confirmation_service_api.yml</inputSpec>
                            <modelPackage>sophrosyne_api.core.actionconfirmationservice.model</modelPackage>
                        </configuration>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <id>create-external-action-confirmation-service-api</id>
                    </execution>

                    <execution>
                        <configuration>
                            <apiPackage>sophrosyne_api.core.internaldropdownoptionservice.api</apiPackage>
                            <configOptions>
                                <interfaceOnly>true</interfaceOnly>
                                <useJakartaEe>true</useJakartaEe>
                            </configOptions>
                            <generatorName>spring</generatorName>
                            <inputSpec>${project.basedir}/apis/internal_dropdown_option_service_api.yml</inputSpec>
