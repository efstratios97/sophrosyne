                            <modelPackage>sophrosyne_api.core.externalexecutorservice.model</modelPackage>
                        </configuration>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <id>create-external-executor-api</id>
                    </execution>

                    <execution>
                        <configuration>
                            <apiPackage>sophrosyne_api.core.dashboardstatistics.api</apiPackage>
                            <configOptions>
                                <interfaceOnly>true</interfaceOnly>
                                <useJakartaEe>true</useJakartaEe>
                            </configOptions>
                            <generatorName>spring</generatorName>
                            <inputSpec>${project.basedir}/apis/dashboard_statistics_api.yml</inputSpec>
                            <modelPackage>sophrosyne_api.core.dashboardstatistics.model</modelPackage>
                        </configuration>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <id>create-dashboard-statistics-api</id>
                    </execution>

                    <execution>
                        <configuration>
                            <apiPackage>sophrosyne_api.core.interalconfigurationservice.api</apiPackage>
