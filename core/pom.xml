                            <inputSpec>${project.basedir}/apis/control_panel_view_service_api.yml</inputSpec>
                            <modelPackage>sophrosyne_api.core.controlpanelviewservice.model</modelPackage>
                        </configuration>
                        <goals>
                            <goal>generate</goal>
                        </goals>
