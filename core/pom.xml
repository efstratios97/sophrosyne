                    <execution>
                        <configuration>
                            <apiPackage>sophrosyne_api.core.controlpaneldashboardgroupservice.api</apiPackage>
                            <configOptions>
                                <interfaceOnly>true</interfaceOnly>
                                <schemaMappings>
                                    ControlPanelDashboard=sophrosyne_api.core.controlpaneldashboardservice.model.ControlPanelDashboard
                                </schemaMappings>
                                <useJakartaEe>true</useJakartaEe>
                            </configOptions>
                            <generatorName>spring</generatorName>
                            <inputSpec>${project.basedir}/apis/control_panel_dashboard_group_service_api.yml</inputSpec>
                            <modelPackage>sophrosyne_api.core.controlpaneldashboardgroupservice.model</modelPackage>
                        </configuration>
                        <goals>
