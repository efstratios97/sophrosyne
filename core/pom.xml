                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <id>create-action-recommendation-service-api</id>
                    </execution>

                    <execution>
                        <configuration>
                            <apiPackage>sophrosyne_api.core.externalactionrecommendationservice.api</apiPackage>
                            <configOptions>
                                <interfaceOnly>true</interfaceOnly>
                                <useJakartaEe>true</useJakartaEe>
                            </configOptions>
                            <generatorName>spring</generatorName>
                            <inputSpec>${project.basedir}/apis/external_action_recommendation_service_api.yml
